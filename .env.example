# Configuración operativa de ImpulsoLocal (plantilla sin secretos reales)
# Copia este archivo a .env.local para desarrollo local:
#   cp .env.example .env.local

# Puerto de ejecución local / contenedor (Azure App Service puede inyectar WEBSITES_PORT o PORT)
PORT=3847

# Entorno lógico reportado por /api/health (local | ci | staging | production)
NEXT_PUBLIC_APP_ENV=local

# Versión desplegada reportada por /api/health (idealmente tag semántico o SHA corto en despliegue)
APP_VERSION=0.1.0

# Token opcional para validar /api/health?check=strict mediante cabecera x-healthcheck-token.
# Déjalo vacío en demo local o configúralo como secreto en GitHub Actions / App Service.
HEALTHCHECK_TOKEN=
